# Copy to .env (never commit .env).
HW_READ_KEY=read-key-local
HW_WRITE_KEY=write-key-local

# Where the SQLite database lives (built on first start).
# HW_DB_PATH=hydrantworks.db

# Chaos mode for hardening labs. Leave empty for a well-behaved service.
HW_CHAOS=
# HW_CHAOS_SEED=7

# Also write the request log (one JSON line per request) to a file.
# HW_REQUEST_LOG=logs/requests.jsonl
